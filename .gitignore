# Local (per-developer) Claude Code settings — never committed.
.claude/settings.local.json

# Investigation scratch / working drafts kept locally.
*.scratch.md

# Repo root: keep only skillset top-level docs. Worked analyses and
# self-tests stay local, never tracked.
/*.md
!/CLAUDE.md
!/README.md
!/AGENTS.md

# Self-test outputs directory.
self-test-results/

# Raw eval runs. The harness and its scored summaries are tracked; the
# per-run agent outputs are not.
evals/runs/
__pycache__/

# Working files pulled during investigations — never tracked.
/tmp_*
/nomis_*.json
